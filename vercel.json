{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/buy",
      "destination": "https://buy.stripe.com/test_6oUeVfb1Vb22cXY1cG08g00",
      "permanent": false
    },
    {
      "source": "/user-guide",
      "destination": "/assets/Atlas%20-%20User%20guide.pdf",
      "permanent": false
    }
  ]
}
